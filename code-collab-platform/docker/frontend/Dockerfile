FROM node:20-alpine AS build

WORKDIR /app

ARG VITE_API_URL=http://localhost/api
ARG VITE_WS_URL=ws://localhost/ws
ARG VITE_AWARENESS_THROTTLE_MS=80
ARG VITE_CURSOR_RENDER_FPS=12
ARG VITE_UNDO_CAPTURE_TIMEOUT_MS=500
ARG VITE_FILE_TIER_OPTIMIZED_BYTES=524288
ARG VITE_FILE_TIER_VIRTUALIZED_BYTES=2097152
ARG VITE_CHUNK_LINE_COUNT=500
ARG VITE_CHUNK_BUFFER_LINES=200

ENV VITE_API_URL=$VITE_API_URL \
    VITE_WS_URL=$VITE_WS_URL \
    VITE_AWARENESS_THROTTLE_MS=$VITE_AWARENESS_THROTTLE_MS \
    VITE_CURSOR_RENDER_FPS=$VITE_CURSOR_RENDER_FPS \
    VITE_UNDO_CAPTURE_TIMEOUT_MS=$VITE_UNDO_CAPTURE_TIMEOUT_MS \
    VITE_FILE_TIER_OPTIMIZED_BYTES=$VITE_FILE_TIER_OPTIMIZED_BYTES \
    VITE_FILE_TIER_VIRTUALIZED_BYTES=$VITE_FILE_TIER_VIRTUALIZED_BYTES \
    VITE_CHUNK_LINE_COUNT=$VITE_CHUNK_LINE_COUNT \
    VITE_CHUNK_BUFFER_LINES=$VITE_CHUNK_BUFFER_LINES

COPY frontend/package.json ./
RUN npm install

COPY frontend/ ./
RUN npm run build

FROM node:20-alpine AS runtime

WORKDIR /app

RUN npm install -g serve@14.2.4 \
    && addgroup -S app \
    && adduser -S app -G app

COPY --from=build /app/dist ./dist

RUN chown -R app:app /app

USER app

EXPOSE 3000

CMD ["serve", "-s", "dist", "-l", "3000"]
