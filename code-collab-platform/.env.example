# Django
SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgres://collab:collab@postgres:5432/collab
REDIS_URL=redis://redis:6379/0

# PostgreSQL (used by postgres service)
POSTGRES_USER=collab
POSTGRES_PASSWORD=collab
POSTGRES_DB=collab

# JWT
JWT_ACCESS_LIFETIME_MIN=15
JWT_REFRESH_LIFETIME_DAYS=7

# WebSocket Abuse (Section 7.6)
WS_MAX_MSG_PER_SEC=60
WS_MAX_UPDATE_PER_SEC=30
WS_ABUSE_STRIKE_BAN_MIN=5
WS_ABUSE_MAX_STRIKES=3

# CRDT Persistence (Section 4.4)
YJS_FLUSH_INTERVAL_SEC=5
YJS_FLUSH_OP_THRESHOLD=50
YJS_COMPACT_OP_THRESHOLD=200
YJS_COMPACT_INTERVAL_SEC=300
YJS_IDLE_COMPACT_SEC=30

# Execution
EXECUTION_TIMEOUT_SEC=5
EXECUTION_MEMORY_MB=256
EXECUTION_RATE_LIMIT=10
EXEC_FAIR_MAX_CONCURRENT=2
EXEC_FAIR_MAX_PENDING_HIGH=3
EXEC_FAIR_MAX_PENDING_LOW=10
EXEC_HIGH_QUEUE=execution.high
EXEC_LOW_QUEUE=execution.low

# AI (Phase 3)
AI_PROVIDER=openai
OPENAI_API_KEY=

# Frontend Editor (Section 4.3.1)
VITE_AWARENESS_THROTTLE_MS=80
VITE_CURSOR_RENDER_FPS=12
VITE_UNDO_CAPTURE_TIMEOUT_MS=500
VITE_FILE_TIER_OPTIMIZED_BYTES=524288
VITE_FILE_TIER_VIRTUALIZED_BYTES=2097152
VITE_CHUNK_LINE_COUNT=500
VITE_CHUNK_BUFFER_LINES=200

# Frontend
VITE_API_URL=http://localhost/api
VITE_WS_URL=ws://localhost/ws
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_WS_PROXY_TARGET=ws://localhost:8000
